{%- style -%}
  #Lookbook-{{ section.id }} {
    --lb-espresso: #3A1E24;
    --lb-cream: #F4ECDE;
    --lb-clay: #C9A24B;
    background: var(--lb-cream);
    color: var(--lb-espresso);
  }
  #Lookbook-{{ section.id }} .lb-inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 2.5rem {{ section.settings.padding_bottom }}px;
  }
  #Lookbook-{{ section.id }} .lb-head {
    max-width: 44ch;
    margin: 0 0 2.6rem;
  }
  #Lookbook-{{ section.id }} .lb-eyebrow {
    font-size: 0.76rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--lb-clay);
    margin: 0 0 0.9rem;
  }
  #Lookbook-{{ section.id }} .lb-title {
    font-family: var(--font-heading-family, inherit);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    font-size: clamp(2rem, 4vw, 3.1rem);
    margin: 0;
  }
  #Lookbook-{{ section.id }} .lb-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  #Lookbook-{{ section.id }} .lb-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  #Lookbook-{{ section.id }} .lb-frame {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 3 / 4;
    background: #EADBC6;
  }
  #Lookbook-{{ section.id }} .lb-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #Lookbook-{{ section.id }} .lb-card:hover .lb-frame img { transform: scale(1.05); }
  #Lookbook-{{ section.id }} .lb-index {
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    background: rgba(250, 246, 239, 0.9);
    color: var(--lb-espresso);
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
  }
  #Lookbook-{{ section.id }} .lb-label {
    font-family: var(--font-heading-family, inherit);
    font-weight: 700;
    font-size: 1.1rem;
    margin: 1rem 0 0.2rem;
  }
  #Lookbook-{{ section.id }} .lb-caption {
    font-size: 0.9rem;
    color: rgba(44, 42, 37, 0.68);
    margin: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    #Lookbook-{{ section.id }} .lb-card {
      opacity: 0;
      transform: translateY(24px);
      animation: lb-rise 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }
    #Lookbook-{{ section.id }} .lb-card:nth-child(2) { animation-delay: 0.12s; }
    #Lookbook-{{ section.id }} .lb-card:nth-child(3) { animation-delay: 0.24s; }
    #Lookbook-{{ section.id }} .lb-card:nth-child(4) { animation-delay: 0.36s; }
    @keyframes lb-rise { to { opacity: 1; transform: translateY(0); } }
  }
  @media screen and (max-width: 749px) {
    #Lookbook-{{ section.id }} .lb-inner { padding-left: 1.5rem; padding-right: 1.5rem; }
    #Lookbook-{{ section.id }} .lb-grid { grid-template-columns: 1fr; gap: 1.8rem; }
  }
{%- endstyle -%}

<section id="Lookbook-{{ section.id }}">
  <div class="lb-inner">
    <div class="lb-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lb-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lb-title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <div class="lb-grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="lb-card"
          {{ block.shopify_attributes }}
        >
          <div class="lb-frame">
            {%- if block.settings.image_url != blank -%}
              <img
                src="{{ block.settings.image_url }}"
                alt="{{ block.settings.label | escape }}"
                loading="lazy"
                width="600"
                height="800"
              >
            {%- endif -%}
            <span class="lb-index">{{ forloop.index | prepend: '0' }}</span>
          </div>
          {%- if block.settings.label != blank -%}
            <p class="lb-label">{{ block.settings.label }}</p>
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <p class="lb-caption">{{ block.settings.caption }}</p>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aurora lookbook",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by style" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your everyday bag" },
    { "type": "range", "id": "padding_top", "min": 40, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 40, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image card",
      "settings": [
        { "type": "text", "id": "image_url", "label": "Image URL", "info": "Paste a public HTTPS image URL." },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Aurora lookbook",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "image_url": "https://images.unsplash.com/photo-1584917865442-de89df76afd3?w=1200&q=80&auto=format&fit=crop",
            "label": "The Structured Tote",
            "caption": "Room for everything, built to keep its shape."
          }
        },
        {
          "type": "card",
          "settings": {
            "image_url": "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=1200&q=80&auto=format&fit=crop",
            "label": "The Crossbody Sling",
            "caption": "Hands-free ease on a chain-and-leather strap."
          }
        },
        {
          "type": "card",
          "settings": {
            "image_url": "https://images.unsplash.com/photo-1566150905458-1bf1fc113f0d?w=1200&q=80&auto=format&fit=crop",
            "label": "The Evening Clutch",
            "caption": "A compact statement for nights out."
          }
        }
      ]
    }
  ]
}
{% endschema %}
