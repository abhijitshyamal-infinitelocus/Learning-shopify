{%- style -%}
  #Tiles-{{ section.id }} {
    --tl-espresso: #3A141C;
    --tl-cream: #F4ECDE;
    --tl-clay: #C9A24B;
    background: var(--tl-cream);
    color: var(--tl-espresso);
  }
  #Tiles-{{ section.id }} .tl-inner {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 2.5rem {{ section.settings.padding_bottom }}px;
  }
  #Tiles-{{ section.id }} .tl-head { max-width: 44ch; margin: 0 0 2.4rem; }
  #Tiles-{{ section.id }} .tl-eyebrow {
    font-size: 0.76rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--tl-clay);
    margin: 0 0 0.9rem;
  }
  #Tiles-{{ section.id }} .tl-title {
    font-family: var(--font-heading-family, inherit);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1;
    font-size: clamp(2rem, 4vw, 3.1rem);
    margin: 0;
  }
  #Tiles-{{ section.id }} .tl-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.4rem;
  }
  #Tiles-{{ section.id }} .tl-tile {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 3 / 2;
    background: #EADBC6;
  }
  #Tiles-{{ section.id }} .tl-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  #Tiles-{{ section.id }} .tl-tile:hover img { transform: scale(1.06); }
  #Tiles-{{ section.id }} .tl-tile::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28, 22, 20, 0) 35%, rgba(28, 22, 20, 0.72) 100%);
  }
  #Tiles-{{ section.id }} .tl-overlay {
    position: absolute;
    z-index: 1;
    left: 1.6rem;
    right: 1.6rem;
    bottom: 1.5rem;
    color: var(--tl-cream);
  }
  #Tiles-{{ section.id }} .tl-label {
    font-family: var(--font-heading-family, inherit);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(1.3rem, 2.2vw, 1.9rem);
    margin: 0 0 0.6rem;
  }
  #Tiles-{{ section.id }} .tl-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tl-cream);
  }
  #Tiles-{{ section.id }} .tl-cta::after {
    content: "→";
    transition: transform 0.2s ease;
  }
  #Tiles-{{ section.id }} .tl-tile:hover .tl-cta::after { transform: translateX(4px); }
  @media (prefers-reduced-motion: no-preference) {
    #Tiles-{{ section.id }} .tl-tile {
      opacity: 0;
      transform: translateY(22px);
      animation: tl-rise 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    }
    #Tiles-{{ section.id }} .tl-tile:nth-child(2) { animation-delay: 0.12s; }
    @keyframes tl-rise { to { opacity: 1; transform: translateY(0); } }
  }
  @media screen and (max-width: 749px) {
    #Tiles-{{ section.id }} .tl-inner { padding-left: 1.5rem; padding-right: 1.5rem; }
    #Tiles-{{ section.id }} .tl-grid { grid-template-columns: 1fr; gap: 1.4rem; }
  }
{%- endstyle -%}

<section id="Tiles-{{ section.id }}">
  <div class="tl-inner">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="tl-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="tl-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tl-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="tl-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="tl-tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image_url != blank -%}
            <img src="{{ block.settings.image_url }}" alt="{{ block.settings.label | escape }}" loading="lazy" width="800" height="533">
          {%- endif -%}
          <div class="tl-overlay">
            {%- if block.settings.label != blank -%}
              <p class="tl-label">{{ block.settings.label }}</p>
            {%- endif -%}
            <span class="tl-cta">{{ block.settings.cta | default: 'Shop now' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aurora tiles",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two ways to carry it" },
    { "type": "range", "id": "padding_top", "min": 40, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 40, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "image_url", "label": "Image URL", "info": "Paste a public HTTPS image URL." },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "cta", "label": "CTA text", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Aurora tiles",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "image_url": "https://images.unsplash.com/photo-1584917865442-de89df76afd3?w=1400&q=80&auto=format&fit=crop",
            "label": "The Totes",
            "cta": "Shop totes"
          }
        },
        {
          "type": "tile",
          "settings": {
            "image_url": "https://images.unsplash.com/photo-1548036328-c9fa89d128fa?w=1400&q=80&auto=format&fit=crop",
            "label": "The Slings",
            "cta": "Shop slings"
          }
        }
      ]
    }
  ]
}
{% endschema %}
