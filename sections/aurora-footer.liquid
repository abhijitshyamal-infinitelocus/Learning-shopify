{%- style -%}
  #AuroraFooter-{{ section.id }} {
    --af-espresso: #2A1116;
    --af-cream: #F4ECDE;
    --af-clay: #C9A24B;
    --af-olive: #7A2E3B;
    --af-line: rgba(245, 236, 230, 0.14);
    background: var(--af-espresso);
    color: var(--af-cream);
  }
  #AuroraFooter-{{ section.id }} .af-inner {
    max-width: 1480px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 2.5rem {{ section.settings.padding_bottom }}px;
  }
  #AuroraFooter-{{ section.id }} .af-top {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: clamp(2rem, 5vw, 5rem);
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--af-line);
  }
  #AuroraFooter-{{ section.id }} .af-brand-name {
    font-family: var(--font-heading-family, inherit);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 2.4rem;
    margin: 0 0 1rem;
  }
  #AuroraFooter-{{ section.id }} .af-tagline {
    font-size: 1.22rem;
    line-height: 1.6;
    color: rgba(245, 236, 230, 0.72);
    max-width: 36ch;
    margin: 0 0 1.6rem;
  }
  #AuroraFooter-{{ section.id }} .af-contact {
    list-style: none;
    margin: 0 0 1.8rem;
    padding: 0;
  }
  #AuroraFooter-{{ section.id }} .af-contact li {
    font-size: 1.08rem;
    line-height: 1.5;
    color: rgba(245, 236, 230, 0.78);
    margin: 0 0 0.5rem;
  }
  #AuroraFooter-{{ section.id }} .af-contact a { color: inherit; text-decoration: none; }
  #AuroraFooter-{{ section.id }} .af-contact a:hover { color: var(--af-clay); }
  #AuroraFooter-{{ section.id }} .af-contact .af-contact-label {
    display: block;
    font-size: 0.8rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--af-clay);
    margin: 0 0 0.4rem;
  }
  #AuroraFooter-{{ section.id }} .af-news-label {
    font-size: 0.9rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--af-clay);
    margin: 0 0 0.9rem;
  }
  #AuroraFooter-{{ section.id }} .af-form {
    display: flex;
    max-width: 400px;
    border: 1px solid var(--af-line);
    border-radius: 4px;
    overflow: hidden;
  }
  #AuroraFooter-{{ section.id }} .af-form input[type="email"] {
    flex: 1;
    background: transparent;
    border: 0;
    padding: 0.95rem 1rem;
    color: var(--af-cream);
    font-size: 1rem;
    min-width: 0;
  }
  #AuroraFooter-{{ section.id }} .af-form input::placeholder { color: rgba(245, 236, 230, 0.45); }
  #AuroraFooter-{{ section.id }} .af-form input:focus { outline: none; }
  #AuroraFooter-{{ section.id }} .af-form button {
    background: var(--af-cream);
    color: var(--af-espresso);
    border: 0;
    padding: 0 1.4rem;
    font-size: 0.84rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.18s ease;
  }
  #AuroraFooter-{{ section.id }} .af-form button:hover { background: var(--af-clay); }
  #AuroraFooter-{{ section.id }} .af-news-msg {
    font-size: 0.9rem;
    margin: 0.7rem 0 0;
    color: var(--af-clay);
  }
  #AuroraFooter-{{ section.id }} .af-cols {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
    gap: 2rem;
  }
  #AuroraFooter-{{ section.id }} .af-col-title {
    font-size: 1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--af-cream);
    margin: 0 0 1.3rem;
  }
  #AuroraFooter-{{ section.id }} .af-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #AuroraFooter-{{ section.id }} .af-col li { margin: 0 0 0.8rem; }
  #AuroraFooter-{{ section.id }} .af-col a {
    color: rgba(245, 236, 230, 0.72);
    text-decoration: none;
    font-size: 1.14rem;
    transition: color 0.18s ease;
  }
  #AuroraFooter-{{ section.id }} .af-col a:hover { color: var(--af-clay); }
  #AuroraFooter-{{ section.id }} .af-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.8rem;
  }
  #AuroraFooter-{{ section.id }} .af-social {
    display: flex;
    gap: 1.4rem;
  }
  #AuroraFooter-{{ section.id }} .af-social a {
    color: rgba(245, 236, 230, 0.72);
    text-decoration: none;
    font-size: 1.02rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.18s ease;
  }
  #AuroraFooter-{{ section.id }} .af-social a:hover { color: var(--af-clay); }
  #AuroraFooter-{{ section.id }} .af-pay {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    align-items: center;
    padding: 1.6rem 0;
    border-top: 1px solid var(--af-line);
    margin-top: 2.4rem;
  }
  #AuroraFooter-{{ section.id }} .af-pay-label {
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 236, 230, 0.55);
  }
  #AuroraFooter-{{ section.id }} .af-pay-badge {
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: var(--af-cream);
    background: rgba(245, 236, 230, 0.08);
    border: 1px solid var(--af-line);
    border-radius: 4px;
    padding: 0.35rem 0.7rem;
  }
  #AuroraFooter-{{ section.id }} .af-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    font-size: 1rem;
    color: rgba(245, 236, 230, 0.55);
  }
  #AuroraFooter-{{ section.id }} .af-legal a {
    color: rgba(245, 236, 230, 0.55);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  #AuroraFooter-{{ section.id }} .af-legal a:hover { color: var(--af-clay); }
  #AuroraFooter-{{ section.id }} .af-note {
    font-size: 0.95rem;
    color: rgba(245, 236, 230, 0.5);
    margin: 1.4rem 0 0;
  }
  @media screen and (max-width: 749px) {
    #AuroraFooter-{{ section.id }} .af-inner { padding-left: 1.5rem; padding-right: 1.5rem; }
    #AuroraFooter-{{ section.id }} .af-top { grid-template-columns: 1fr; gap: 2.4rem; }
    #AuroraFooter-{{ section.id }} .af-cols { grid-template-columns: 1fr 1fr; }
    #AuroraFooter-{{ section.id }} .af-bottom { flex-direction: column; align-items: flex-start; }
  }
{%- endstyle -%}

<footer id="AuroraFooter-{{ section.id }}">
  <div class="af-inner">
    <div class="af-top">
      <div class="af-brand">
        <p class="af-brand-name">{{ section.settings.brand_name | default: shop.name }}</p>
        {%- if section.settings.tagline != blank -%}
          <p class="af-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.contact_email != blank or section.settings.contact_phone != blank or section.settings.contact_address != blank -%}
          <ul class="af-contact">
            <li><span class="af-contact-label">Get in touch</span></li>
            {%- if section.settings.contact_email != blank -%}
              <li><a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></li>
            {%- endif -%}
            {%- if section.settings.contact_phone != blank -%}
              <li><a href="tel:{{ section.settings.contact_phone | remove: ' ' }}">{{ section.settings.contact_phone }}</a></li>
            {%- endif -%}
            {%- if section.settings.contact_address != blank -%}
              <li>{{ section.settings.contact_address }}</li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.newsletter_enable -%}
          <p class="af-news-label">{{ section.settings.newsletter_heading }}</p>
          {%- form 'customer' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="af-form">
              <input
                type="email"
                name="contact[email]"
                placeholder="Email address"
                autocorrect="off"
                autocapitalize="off"
                required
              >
              <button type="submit" name="commit">Subscribe</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="af-news-msg">Thanks — you're on the list.</p>
            {%- elsif form.errors -%}
              <p class="af-news-msg">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>

      <div class="af-cols">
        {%- for block in section.blocks -%}
          {%- assign h = block.settings.heading | downcase -%}
          <div class="af-col" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <p class="af-col-title">{{ block.settings.heading }}</p>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- elsif h contains 'shop' -%}
              <ul>
                <li><a href="{{ routes.all_products_collection_url }}">All bags</a></li>
                <li><a href="{{ routes.all_products_collection_url }}">Totes</a></li>
                <li><a href="{{ routes.all_products_collection_url }}">Slings &amp; crossbody</a></li>
                <li><a href="{{ routes.all_products_collection_url }}">Clutches</a></li>
                <li><a href="{{ routes.all_products_collection_url }}">Backpacks</a></li>
              </ul>
            {%- elsif h contains 'help' or h contains 'support' -%}
              <ul>
                <li><a href="{{ routes.search_url }}">Search</a></li>
                <li><a href="{{ routes.cart_url }}">Your cart</a></li>
                <li><a href="{{ routes.account_url }}">Track your order</a></li>
                <li><a href="/pages/contact">Contact us</a></li>
                <li><a href="/pages/faq">Shipping &amp; returns</a></li>
              </ul>
            {%- elsif h contains 'company' or h contains 'about' -%}
              <ul>
                <li><a href="/pages/about">Our story</a></li>
                <li><a href="/pages/stores">Stores</a></li>
                <li><a href="/pages/sustainability">Sustainability</a></li>
                <li><a href="/pages/careers">Careers</a></li>
                <li><a href="{{ routes.all_products_collection_url }}">Gift cards</a></li>
              </ul>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="af-pay">
      <span class="af-pay-label">We accept</span>
      <span class="af-pay-badge">VISA</span>
      <span class="af-pay-badge">Mastercard</span>
      <span class="af-pay-badge">RuPay</span>
      <span class="af-pay-badge">UPI</span>
      <span class="af-pay-badge">Amex</span>
      <span class="af-pay-badge">COD</span>
    </div>

    <div class="af-bottom">
      <div class="af-social">
        {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>{%- else -%}<a href="#">Instagram</a>{%- endif -%}
        {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a>{%- else -%}<a href="#">Facebook</a>{%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}<a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">Pinterest</a>{%- else -%}<a href="#">Pinterest</a>{%- endif -%}
        {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener">YouTube</a>{%- else -%}<a href="#">YouTube</a>{%- endif -%}
      </div>
      <div class="af-legal">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}</span>
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <a href="{{ policy.url }}">{{ policy.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.bottom_note != blank -%}
      <p class="af-note">{{ section.settings.bottom_note }}</p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Aurora footer",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "info": "Leave blank to use the store name.", "default": "Miraggio" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Vegan-leather handbags, slings, and clutches — designed in India to elevate your everyday." },
    { "type": "header", "content": "Contact" },
    { "type": "text", "id": "contact_email", "label": "Email", "default": "care@miraggio.com" },
    { "type": "text", "id": "contact_phone", "label": "Phone", "default": "+91 98765 43210" },
    { "type": "text", "id": "contact_address", "label": "Address", "default": "Mon–Sat, 10am–7pm IST" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "newsletter_enable", "label": "Show email signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join the Miraggio world" },
    { "type": "header", "content": "Bottom note" },
    { "type": "text", "id": "bottom_note", "label": "Bottom note", "default": "Designed with love and made responsibly in India." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 40, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 24, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Optional. Leave empty to show default links based on the heading (Shop / Help / Company)." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Aurora footer",
      "blocks": [
        { "type": "column", "settings": { "heading": "Shop" } },
        { "type": "column", "settings": { "heading": "Help" } },
        { "type": "column", "settings": { "heading": "Company" } }
      ]
    }
  ]
}
{% endschema %}
