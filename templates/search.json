        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "enable_filtering": true,
        "filter_type": "horizontal",
        "enable_sorting": true,
        "article_show_date": true,
        "article_show_author": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "offer_strip",
    "main"
  ]
