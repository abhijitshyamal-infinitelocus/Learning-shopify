{
  "sections": {
    "offer_strip": {
      "type": "aurora-offer-strip",
      "blocks": {
        "o1": { "type": "item", "settings": { "text": "Free shipping over ₹1499" } },
        "o2": { "type": "item", "settings": { "text": "10% off your first order" } },
        "o3": { "type": "item", "settings": { "text": "1-year warranty" } }
      },
      "block_order": ["o1", "o2", "o3"],
      "settings": { "padding_top": 16, "padding_bottom": 16 }
